# =====================================================================
# Skyevenapp — variables d'environnement (MODÈLE SANS SECRETS)
# Ne jamais committer de vraies valeurs. En production : Render > service > Environment
# (DATABASE_URL est reliée automatiquement par render.yaml). En local : « pnpm setup:env ».
# =====================================================================

# ---------- Les deux services ----------
# Base PostgreSQL. Sur Render : « Internal Database URL » (reliée par render.yaml). En local : docker-compose.yml.
DATABASE_URL=postgresql://ceremonia:ceremonia-local@localhost:5433/ceremonia
# Seulement pour une URL externe Render (ex. création de l'admin depuis votre PC) : no-verify
# DATABASE_SSL=
# URL publique de l'espace organisateur (invitations, personnel, paiement, API v1, webhooks). https, sans / final.
ORGANIZER_ORIGIN=https://ceremonia-app.onrender.com
# URL publique de l'espace admin. Doit être un AUTRE domaine que ORGANIZER_ORIGIN.
ADMIN_ORIGIN=https://cer-console-xxxxxxxx.onrender.com

# ---------- Service ceremonia-app uniquement ----------
# E-mail de réinitialisation du mot de passe via Resend (inscription sans e-mail, sauf SIGNUP_EMAIL_CONFIRMATION=1). Vides : pas d'e-mail en production
# (inscription sans vérification d'adresse, « mot de passe oublié » indisponible — affiché honnêtement).
RESEND_API_KEY=
MAIL_FROM=
# Paiements (côté serveur uniquement). Vides = moyen désactivé ; l'envoi des invitations reste bloqué sans règlement.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# Wonya Pay (mobile money RDC, CDF ou USD). Renseigné, il remplace CinetPay pour le mobile money.
# Token du projet (wya_live_…) et secret de signature des callbacks (paramètres du projet Wonya).
# URL du callback à déclarer chez Wonya : <ORGANIZER_ORIGIN>/api/webhooks/wonyapay
WONYAPAY_TOKEN=
WONYAPAY_WEBHOOK_SECRET=
# Paiement simulé (aucun argent encaissé). Toujours permis en local ; en production, refusé sauf PAYMENT_SIMULATION=1.
# À ne définir que pour une démonstration : tout organisateur pourrait activer ses événements sans payer.
PAYMENT_SIMULATION=

# ---------- Service admin uniquement ----------
# Déconnexion automatique de l'admin après inactivité (minutes).
ADMIN_IDLE_MINUTES=30
# Les tâches planifiées ne tournent que dans ceremonia-app.
DISABLE_SCHEDULER=1

# ---------- Facultatif ----------
# DATABASE_POOL_MAX=5        connexions par service (base Render 256 Mo : garder petit)

# ---------- Local uniquement (jamais en ligne) ----------
# DEV_PAYMENTS=1             paiement simulé, confirmé par « pnpm dev:confirm-payment <référence> »
