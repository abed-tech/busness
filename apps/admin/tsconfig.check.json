{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": [],
    "typeRoots": [
      "/opt/npm-tools/node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@ceremonia/core": [
        "../../packages/core/src/index.ts"
      ],
      "zod": [
        "/opt/npm-tools/node_modules/zod"
      ],
      "@ceremonia/server": [
        "../../packages/server/src/index.ts"
      ]
    }
  },
  "include": [
    "types/local-shims.d.ts",
    "types/local-shims-jsx.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
